# Copy to .env.local. No secrets here: the Bolna key and everything else stays in apps/api.
# Where Next.js reaches FastAPI (server-side fetches and the /api/* rewrite).
API_URL=http://localhost:8000
# Show "Talk in browser". The Web Call SDK is enabled on our Bolna account (a session mint worked on 2026-10-20).
NEXT_PUBLIC_WEB_CALL_ENABLED=true
