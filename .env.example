# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_API_BASE=https://api.bolna.ai
# Shared secret Bolna sends on webhooks (set the same value in the Bolna dashboard) [verify Bolna's signing options]
WEBHOOK_SECRET=change-me

# --- LLM provider (pick one) ---
# Default: Anthropic. Uses ANTHROPIC_API_KEY. LLM_MODEL defaults to claude-opus-5-5, LLM_MODEL_CHEAP to claude-haiku-5-5.
LLM_PROVIDER=anthropic
# Free / cheap option: any OpenAI-compatible endpoint. Example (Gemini's compatibility endpoint) [VERIFY URL + model name in Google AI Studio docs]:
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=<your free key>
# LLM_MODEL=<best free model you have access to>
# LLM_MODEL_CHEAP=<a smaller free model for simulated users>
# Other options: Groq (https://api.groq.com/openai/v1), OpenRouter (https://openrouter.ai/api/v1), local Ollama (http://localhost:11434/v1)

# Invite page (build-plans/01-invite-page.md)
# Absolute path, so uvicorn (started from apps/api) and scripts/make_invites.py (from the root) share one data folder
CHURNCALL_DATA_DIR=/absolute/path/to/repo/data
# Public URL invite links are built from (static ngrok domain, or the deployed web app)
PUBLIC_BASE_URL=https://your-static-domain.ngrok-free.app
# Protects GET /admin/funnel (send it as the X-Admin-Key header; not reachable through Next.js)
ADMIN_KEY=change-me-too
# "local" turns on FastAPI's /docs on your machine; anything else (default) turns them off
CHURNCALL_ENV=local
