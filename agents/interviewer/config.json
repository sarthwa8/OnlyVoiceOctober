{
  "_comment": "Bolna agent settings for the ChurnCall interviewer, in Bolna's POST /v2/agent schema (checked against the docs on 2026-10-20). agents/sync.py adds the welcome message and system prompt from prompt.md. Voice = ElevenLabs 'Chris - Friendly conversational guide'; swap voice/voice_id from Bolna's voice list if you want a different one. 2026-10-28: max_tokens 150->60 (backstop for short turns) and endpointing 900->700 ms (saves ~200 ms per reply) after the first real interview; listen for cut-offs and go back to 800-900 if people get interrupted.",
  "agent_name": "churncall-interviewer-v1",
  "agent_type": "other",
  "tasks": [
    {
      "task_type": "conversation",
      "toolchain": {"execution": "sequential", "pipelines": [["transcriber", "llm", "synthesizer"]]},
      "tools_config": {
        "llm_agent": {
          "agent_type": "simple_llm_agent",
          "agent_flow_type": "streaming",
          "llm_config": {"provider": "openai", "model": "gpt-4.1-mini", "max_tokens": 60, "temperature": 0.3}
        },
        "synthesizer": {
          "provider": "elevenlabs",
          "provider_config": {"voice": "Chris", "voice_id": "gScUm0AQVZBQ1uUp8KvE", "model": "eleven_turbo_v2_5"},
          "stream": true,
          "buffer_size": 250,
          "audio_format": "wav"
        },
        "transcriber": {
          "provider": "deepgram",
          "model": "nova-3",
          "language": "en",
          "stream": true,
          "encoding": "linear16",
          "sampling_rate": 16000,
          "endpointing": 700
        },
        "input": {"provider": "plivo", "format": "wav"},
        "output": {"provider": "plivo", "format": "wav"}
      },
      "task_config": {
        "call_terminate": 360,
        "hangup_after_silence": 20,
        "check_if_user_online": true,
        "trigger_user_online_message_after": 8,
        "number_of_words_for_interruption": 2
      }
    }
  ]
}
